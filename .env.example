# 네이버 검색 API (뉴스) - 개발자 센터에서 발급
# https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=your_client_id
NAVER_CLIENT_SECRET=your_client_secret

# OpenAI (summarize_exec_news_llm.py) — GitHub Actions Secrets 에도 OPENAI_API_KEY 등록
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Gmail 발송 - 앱 비밀번호(공백 없이), 발신·수신 주소
# 로컬: 이 파일을 .env 로 복사 후 값 채움
# GitHub Actions: 저장소 Settings → Secrets and variables → Actions 에서 GMAIL_APP_PASSWORD, GMAIL_SENDER, GMAIL_TO 등록
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx  (16자, 공백 제거)
# GMAIL_SENDER=naverpartnership@gmail.com
# GMAIL_TO=juan.jung@navercorp.com
